# API Key de OpenAI (requerido)
OPENAI_API_KEY=tu_api_key_aqui

# Puerto del servidor (opcional, default 3001)
PORT=3001

# URL pública del servidor (para mostrar en configuración de Twilio)
# En desarrollo: dejar vacío (se muestra localhost)
# En producción: poner la URL real, ej: https://miapp.railway.app
PUBLIC_URL=
